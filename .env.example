# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=card-transactions
KAFKA_DLQ_TOPIC=card-transactions-dlq

# Snowflake
SNOWFLAKE_ACCOUNT=your_account.snowflakecomputing.com
SNOWFLAKE_USER=pipeline_user
SNOWFLAKE_PASSWORD=your_password
SNOWFLAKE_DATABASE=FINTECH
SNOWFLAKE_SCHEMA=RAW
SNOWFLAKE_WAREHOUSE=COMPUTE_WH

# PII
PII_TOKENIZATION_SECRET=change-me-in-production

# Slack
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Monitoring
PROMETHEUS_PORT=9000

# Job Pipeline (job_pipeline_v2.py)
ANTHROPIC_API_KEY=your_anthropic_api_key
NOTION_TOKEN=secret_your_notion_integration_token
NOTION_DB_ID=your_notion_database_id
APIFY_TOKEN=your_apify_token  # optional — required for LinkedIn scraping
